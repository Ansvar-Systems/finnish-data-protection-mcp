{
  "name": "@ansvar/finnish-data-protection-mcp",
  "version": "0.1.0",
  "mcpName": "eu.ansvar/finnish-data-protection-mcp",
  "description": "Tietosuojavaltuutetun toimisto (Finnish data protection authority) MCP server — decisions, sanctions, and guidance on GDPR enforcement in Finland",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "finnish-data-protection-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ansvar-Systems/finnish-data-protection-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Ansvar-Systems/finnish-data-protection-mcp/issues"
  },
  "homepage": "https://github.com/Ansvar-Systems/finnish-data-protection-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "tietosuojavaltuutettu",
    "finnish-data-protection",
    "gdpr",
    "finland",
    "data-protection",
    "compliance",
    "ansvar"
  ],
  "author": "Ansvar Systems AB <hello@ansvar.ai>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/http-server.ts",
    "start": "node dist/http-server.js",
    "seed": "npx tsx scripts/seed-sample.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test:contract": "echo \"No contract tests yet\" && exit 0",
    "ingest:fetch": "tsx scripts/ingest-fetch.ts",
    "ingest:diff": "tsx scripts/ingest-diff.ts",
    "coverage:update": "tsx scripts/update-coverage.ts",
    "freshness:check": "tsx scripts/check-freshness.ts",
    "coverage:verify": "tsx scripts/verify-coverage.ts",
    "ingest:full": "npm run ingest:fetch && npm run build:db && npm run coverage:update"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^25.9.3",
    "cheerio": "^1.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^9.4.3",
    "zod": "^3.22.4"
  }
}
